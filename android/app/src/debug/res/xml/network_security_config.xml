<?xml version="1.0" encoding="utf-8"?>
<!-- Texto claro solo hacia el anfitrión visto desde el emulador (10.0.2.2) y hacia el PC por
     `adb reverse` (127.0.0.1), y solo en depuración: todo lo demás sigue en HTTPS, como en el .apk
     publicado. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
