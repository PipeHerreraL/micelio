<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del icono adaptable: el degradado del botón del núcleo (src/ui/core-art.ts). La capa mide
     108 dp y se ven los 72 del centro: el centro y el radio del SVG (45 % y 75 % del icono visible)
     pasan a 18 + 0,45 · 72 = 50,4 dp (0,467) y 0,75 · 72 = 54 dp (50 % de la capa). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.5"
        android:centerY="0.467"
        android:gradientRadius="50%"
        android:startColor="#5A4030"
        android:centerColor="#4A3424"
        android:endColor="#1B140F" />
</shape>
