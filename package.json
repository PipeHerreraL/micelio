{
  "name": "micelio",
  "version": "1.4.2",
  "private": true,
  "description": "Juego idle para navegador: una red de hongos que crece bajo el suelo del bosque.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "budget": "node scripts/budget.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/simulate.ts && node scripts/simulate-plasmodium.ts && prettier --write docs/BALANCE.md --log-level warn",
    "sim:plasmodio": "node scripts/simulate-plasmodium.ts && prettier --write docs/BALANCE.md --log-level warn",
    "test:e2e": "playwright test",
    "perf": "playwright test perf --workers=1",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0"
  }
}
